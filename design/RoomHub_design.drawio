<mxfile host="app.diagrams.net" agent="RoomHub design generator v2" version="24.7.17"><diagram name="00. Mục lục" id="idx"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="idx-1" value="&lt;b style='font-size:26px'&gt;RoomHub – Bộ sơ đồ thiết kế&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="44" as="geometry"/></mxCell><mxCell id="idx-2" value="&lt;b&gt;A. Phân tích yêu cầu nghiệp vụ&lt;/b&gt;&lt;hr size='1'&gt;• 01 Context Diagram&lt;br&gt;• 02a–c Use Case (tổng quát / Người dùng / Quản trị viên)&lt;br&gt;• 03 Activity – Đặt phòng &amp; duyệt&lt;br&gt;• 04a–b Activity – Sử dụng phòng (khóa số / khóa cơ, vắng mặt, bảo trì)&lt;br&gt;• 05a–b User Flow (Người dùng / Quản trị viên)&lt;br&gt;• 06a–c Wireframe (xác thực / Người dùng / Quản trị viên)&lt;br&gt;• 07 Functional Decomposition" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="560" height="183" as="geometry"/></mxCell><mxCell id="idx-3" value="&lt;b&gt;B. Kiến trúc&lt;/b&gt;&lt;hr size='1'&gt;• 08 System Architecture&lt;br&gt;• 09 C4 L1 – System Context&lt;br&gt;• 10 C4 L2 – Container&lt;br&gt;• 11a C4 L3 – Component (App)&lt;br&gt;• 11b Ma trận phụ thuộc module&lt;br&gt;• 12 C4 L3 – Component (Server)&lt;br&gt;• 13 UML Component&lt;br&gt;• 14 Deployment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacing=8;fontSize=13;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="269" width="560" height="204" as="geometry"/></mxCell><mxCell id="idx-4" value="&lt;b&gt;C. Thiết kế chi tiết&lt;/b&gt;&lt;hr si